MAX_PHONE=+79990000000
TRIGGER_PREFIX=@a 
COMMAND_PREFIX=!ai

# Провайдеры (агрегаторы) нейросетей в формате JSON.
# kind: openai_compatible (OpenRouter, Groq, любой OpenAI-совместимый API) | gemini
# Ключи объекта — произвольные имена, переключаются командой "!ai provider <имя>".
AI_PROVIDERS={"openrouter":{"kind":"openai_compatible","base_url":"https://openrouter.ai/api/v1","api_key":"sk-or-...","default_model":"meta-llama/llama-3.3-70b-instruct:free"},"groq":{"kind":"openai_compatible","base_url":"https://api.groq.com/openai/v1","api_key":"gsk-...","default_model":"llama-3.3-70b-versatile"},"gemini":{"kind":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta","api_key":"AIza...","default_model":"gemini-2.0-flash"}}

# Какой провайдер использовать по умолчанию, если в чате не выбран свой
AI_DEFAULT_PROVIDER=openrouter

# ID пользователей MAX, которым разрешено менять настройки бота (через запятую).
# Если оставить пустым — команды настройки доступны всем, кто пишет боту.
ADMIN_IDS=

# Сколько последних пар "вопрос-ответ" подмешивать в контекст запроса к ИИ
HISTORY_CONTEXT_TURNS=6
HISTORY_DB_PATH=cache/history.db

# Веб-поиск для нейросети: none | searxng | keenable
SEARCH_ENGINE=none
SEARXNG_URL=http://localhost:8080
# Необязательно: без ключа Keenable тоже работает, но с более низким лимитом запросов
KEENABLE_API_KEY=
SEARCH_MAX_RESULTS=5

# Выполнение shell-команд в контейнере командой "!ai sh <команда>".
# ОПАСНО: фактически удалённый шелл на сервере. Выключено по умолчанию.
# Если включаете — ADMIN_IDS обязателен и должен содержать ТОЛЬКО ваш ID,
# иначе команда "sh" останется недоступной, даже если SHELL_EXEC_ENABLED=true.
# Подробности и риски — в README, раздел "Выполнение команд в контейнере".
SHELL_EXEC_ENABLED=false
SHELL_EXEC_TIMEOUT=30

# --- устаревшие переменные (используются только если AI_PROVIDERS не задан) ---
# AI_KIND=openai_compatible
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
